rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'yuwon6881@gmail.com' ||
        request.auth.token.email == 'ywc4724@gmail.com'
      );
    }

    // Validation Blueprint: Club
    function isValidClub(data) {
      return data.keys().hasAll([
        'name', 'description', 'paymentInfo', 'freeCancelHours', 'lockCancelHours',
        'lateCancelFeePercent', 'noShowFeePercent', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'name', 'description', 'paymentInfo', 'freeCancelHours', 'lockCancelHours',
        'lateCancelFeePercent', 'noShowFeePercent', 'visibility', 'ownerPlayerId',
        'excludeOwnerFromBilling', 'defaultMatchTargetPoints', 'currency', 'paymentDetailsJson',
        'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      (!('visibility' in data) || data.visibility in ['public', 'private']) &&
      (!('ownerPlayerId' in data) || data.ownerPlayerId == '' || isValidId(data.ownerPlayerId)) &&
      (!('excludeOwnerFromBilling' in data) || data.excludeOwnerFromBilling is bool) &&
      (!('defaultMatchTargetPoints' in data) || (data.defaultMatchTargetPoints is number && data.defaultMatchTargetPoints >= 1 && data.defaultMatchTargetPoints <= 100)) &&
      (!('currency' in data) || (data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10)) &&
      (!('paymentDetailsJson' in data) || (data.paymentDetailsJson is string && data.paymentDetailsJson.size() >= 0 && data.paymentDetailsJson.size() <= 2000)) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
      data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
      data.paymentInfo is string && data.paymentInfo.size() >= 1 && data.paymentInfo.size() <= 160 &&
      data.freeCancelHours is number && data.freeCancelHours >= 0 && data.freeCancelHours <= 720 &&
      data.lockCancelHours is number && data.lockCancelHours >= 0 && data.lockCancelHours <= 720 &&
      data.lateCancelFeePercent is number && data.lateCancelFeePercent >= 0 && data.lateCancelFeePercent <= 100 &&
      data.noShowFeePercent is number && data.noShowFeePercent >= 0 && data.noShowFeePercent <= 100 &&
      isValidId(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: Session
    function isValidSession(data) {
      return data.keys().hasAll([
        'clubId', 'title', 'venue', 'courtNumbers', 'sessionDate', 'startTime', 'endTime',
        'bookingStatus', 'courtFee', 'shuttlesUsed', 'shuttleUnitCost', 'shuttleFee',
        'maxPlayers', 'organizerName', 'paymentInfo', 'feeSplitFinalized',
        'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'clubId', 'title', 'venue', 'courtNumbers', 'sessionDate', 'startTime', 'endTime',
        'bookingStatus', 'courtFee', 'shuttlesUsed', 'shuttleUnitCost', 'shuttleFee',
        'maxPlayers', 'organizerName', 'paymentInfo', 'feeSplitFinalized',
        'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.clubId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.venue is string && data.venue.size() >= 1 && data.venue.size() <= 120 &&
      data.courtNumbers is string && data.courtNumbers.size() >= 1 && data.courtNumbers.size() <= 60 &&
      data.sessionDate is string && data.sessionDate.size() >= 1 && data.sessionDate.size() <= 40 &&
      data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 20 &&
      data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 20 &&
      data.bookingStatus is string && data.bookingStatus.size() >= 1 && data.bookingStatus.size() <= 20 &&
      (data.bookingStatus == 'pending' || data.bookingStatus == 'booked' || data.bookingStatus == 'in_play' || data.bookingStatus == 'completed') &&
      data.courtFee is number && data.courtFee >= 0 && data.courtFee <= 100000 &&
      data.shuttlesUsed is number && data.shuttlesUsed >= 0 && data.shuttlesUsed <= 1000 &&
      data.shuttleUnitCost is number && data.shuttleUnitCost >= 0 && data.shuttleUnitCost <= 1000 &&
      data.shuttleFee is number && data.shuttleFee >= 0 && data.shuttleFee <= 100000 &&
      data.maxPlayers is number && data.maxPlayers >= 2 && data.maxPlayers <= 64 &&
      data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 80 &&
      data.paymentInfo is string && data.paymentInfo.size() >= 1 && data.paymentInfo.size() <= 160 &&
      data.feeSplitFinalized is bool &&
      isValidId(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: Player
    function isValidPlayer(data) {
      return data.keys().hasAll([
        'name', 'playerTag', 'joinedClubIdsCsv',
        'wins', 'losses', 'gamesPlayed', 'pointsScored', 'pointsConceded',
        'singlesWins', 'singlesLosses', 'doublesWins', 'doublesLosses',
        'ratingScore', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'name', 'playerTag', 'joinedClubIdsCsv',
        'wins', 'losses', 'gamesPlayed', 'pointsScored', 'pointsConceded',
        'singlesWins', 'singlesLosses', 'doublesWins', 'doublesLosses',
        'ratingScore', 'authUid', 'actingClubId', 'lastMatchId', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      (!('authUid' in data) || data.authUid == '' || isValidId(data.authUid)) &&
      (!('actingClubId' in data) || data.actingClubId == '' || isValidId(data.actingClubId)) &&
      (!('lastMatchId' in data) || data.lastMatchId == '' || isValidId(data.lastMatchId)) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
      data.playerTag is string && data.playerTag.size() >= 1 && data.playerTag.size() <= 40 &&
      data.joinedClubIdsCsv is string && data.joinedClubIdsCsv.size() >= 0 && data.joinedClubIdsCsv.size() <= 400 &&
      data.wins is number && data.wins >= 0 && data.wins <= 100000 &&
      data.losses is number && data.losses >= 0 && data.losses <= 100000 &&
      data.gamesPlayed is number && data.gamesPlayed >= 0 && data.gamesPlayed <= 200000 &&
      data.pointsScored is number && data.pointsScored >= 0 && data.pointsScored <= 5000000 &&
      data.pointsConceded is number && data.pointsConceded >= 0 && data.pointsConceded <= 5000000 &&
      data.singlesWins is number && data.singlesWins >= 0 && data.singlesWins <= 100000 &&
      data.singlesLosses is number && data.singlesLosses >= 0 && data.singlesLosses <= 100000 &&
      data.doublesWins is number && data.doublesWins >= 0 && data.doublesWins <= 100000 &&
      data.doublesLosses is number && data.doublesLosses >= 0 && data.doublesLosses <= 100000 &&
      data.ratingScore is number && data.ratingScore >= 0 && data.ratingScore <= 10000 &&
      isValidId(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: SessionRsvp
    function isValidSessionRsvp(data) {
      return data.keys().hasAll([
        'clubId', 'sessionId', 'playerId', 'playerName', 'status',
        'attendanceOutcome', 'penaltyPercentApplied', 'feeShare',
        'paidStatus', 'paidMethod', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'clubId', 'sessionId', 'playerId', 'playerName', 'guestCount', 'guestNames', 'status',
        'attendanceOutcome', 'penaltyPercentApplied', 'feeShare',
        'grossFeeShare', 'walletCreditApplied', 'walletPassApplied', 'walletWaiverApplied',
        'paidStatus', 'paidMethod', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.clubId) &&
      isValidId(data.sessionId) &&
      isValidId(data.playerId) &&
      data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 80 &&
      (!('guestCount' in data) || (data.guestCount is int && data.guestCount >= 0 && data.guestCount <= 4)) &&
      (!('guestNames' in data) || (data.guestNames is string && data.guestNames.size() <= 200)) &&
      data.status is string && data.status.size() >= 1 && data.status.size() <= 20 &&
      (data.status == 'going' || data.status == 'out' || data.status == 'late_out') &&
      data.attendanceOutcome is string && data.attendanceOutcome.size() >= 1 && data.attendanceOutcome.size() <= 20 &&
      (data.attendanceOutcome == 'present' || data.attendanceOutcome == 'no_show' || data.attendanceOutcome == 'excused') &&
      data.penaltyPercentApplied is number && data.penaltyPercentApplied >= 0 && data.penaltyPercentApplied <= 100 &&
      data.feeShare is number && data.feeShare >= 0 && data.feeShare <= 100000 &&
      (!('grossFeeShare' in data) || (data.grossFeeShare is number && data.grossFeeShare >= 0 && data.grossFeeShare <= 100000)) &&
      (!('walletCreditApplied' in data) || (data.walletCreditApplied is number && data.walletCreditApplied >= 0 && data.walletCreditApplied <= 100000)) &&
      (!('walletPassApplied' in data) || data.walletPassApplied is bool) &&
      (!('walletWaiverApplied' in data) || data.walletWaiverApplied is bool) &&
      data.paidStatus is string && data.paidStatus.size() >= 1 && data.paidStatus.size() <= 20 &&
      (data.paidStatus == 'unpaid' || data.paidStatus == 'pending_approval' || data.paidStatus == 'paid') &&
      data.paidMethod is string && data.paidMethod.size() >= 1 && data.paidMethod.size() <= 40 &&
      isValidId(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: BadmintonMatch
    function isValidBadmintonMatch(data) {
      return data.keys().hasAll([
        'clubId', 'sessionId', 'matchFormat', 'teamAPlayer1Id', 'teamAPlayer1Name',
        'teamAPlayer2Id', 'teamAPlayer2Name', 'teamBPlayer1Id', 'teamBPlayer1Name',
        'teamBPlayer2Id', 'teamBPlayer2Name', 'scoreTeamA', 'scoreTeamB',
        'setScoresText', 'winnerSide', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'clubId', 'sessionId', 'matchFormat', 'teamAPlayer1Id', 'teamAPlayer1Name',
        'teamAPlayer2Id', 'teamAPlayer2Name', 'teamBPlayer1Id', 'teamBPlayer1Name',
        'teamBPlayer2Id', 'teamBPlayer2Name', 'scoreTeamA', 'scoreTeamB',
        'setScoresText', 'winnerSide', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.clubId) &&
      isValidId(data.sessionId) &&
      data.matchFormat is string && data.matchFormat.size() >= 1 && data.matchFormat.size() <= 20 &&
      (data.matchFormat == 'singles' || data.matchFormat == 'doubles') &&
      isValidId(data.teamAPlayer1Id) &&
      data.teamAPlayer1Name is string && data.teamAPlayer1Name.size() >= 1 && data.teamAPlayer1Name.size() <= 80 &&
      isValidId(data.teamAPlayer2Id) &&
      data.teamAPlayer2Name is string && data.teamAPlayer2Name.size() >= 1 && data.teamAPlayer2Name.size() <= 80 &&
      isValidId(data.teamBPlayer1Id) &&
      data.teamBPlayer1Name is string && data.teamBPlayer1Name.size() >= 1 && data.teamBPlayer1Name.size() <= 80 &&
      isValidId(data.teamBPlayer2Id) &&
      data.teamBPlayer2Name is string && data.teamBPlayer2Name.size() >= 1 && data.teamBPlayer2Name.size() <= 80 &&
      data.scoreTeamA is int && data.scoreTeamA >= 0 && data.scoreTeamA <= 500 &&
      data.scoreTeamB is int && data.scoreTeamB >= 0 && data.scoreTeamB <= 500 &&
      // Badminton has no draws, and the winner must be the side with more points
      data.scoreTeamA != data.scoreTeamB &&
      data.setScoresText is string && data.setScoresText.size() >= 1 && data.setScoresText.size() <= 60 &&
      data.winnerSide is string && data.winnerSide.size() >= 1 && data.winnerSide.size() <= 5 &&
      data.winnerSide == (data.scoreTeamA > data.scoreTeamB ? 'A' : 'B') &&
      isValidId(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------------------------
    // Account-linked identity
    // A player profile is linked to a Firebase Auth account through players/{id}.authUid.
    // A club's owner is the player in clubs/{id}.ownerPlayerId. Every role check below
    // resolves to "is the signed-in account linked to that player?".
    // ---------------------------------------------------------------------------
    function playerPath(pid) {
      return /databases/$(database)/documents/players/$(pid);
    }

    function clubPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId);
    }

    function isPlayerSelf(pid) {
      return isVerifiedUser() && isValidId(pid) && exists(playerPath(pid)) &&
        get(playerPath(pid)).data.get('authUid', '') == request.auth.uid;
    }

    function isClubOwner(clubId) {
      return isVerifiedUser() && isValidId(clubId) && exists(clubPath(clubId)) &&
        isPlayerSelf(get(clubPath(clubId)).data.get('ownerPlayerId', ''));
    }

    function canManageClub(clubId) {
      return isAdmin() || isClubOwner(clubId);
    }

    function clubIsPublic(clubId) {
      return isValidId(clubId) && exists(clubPath(clubId)) &&
        get(clubPath(clubId)).data.get('visibility', 'public') != 'private';
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function sessionIsOpen(sessionId) {
      return get(sessionPath(sessionId)).data.bookingStatus != 'completed';
    }

    function sessionIsFinalized(sessionId) {
      return get(sessionPath(sessionId)).data.feeSplitFinalized == true;
    }

    // Collection: /admins/{uid} — managed from the Firebase console; accounts may only check themselves
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
    }

    // Collection: /clubs/{clubId}
    // Only Site Admins create, delete, or reassign clubs; the club's owner edits its settings.
    match /clubs/{clubId} {
      allow get, list: if isVerifiedUser();
      allow create: if isAdmin() && isValidId(clubId) && isValidClub(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(clubId) && isValidClub(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isClubOwner(clubId) &&
            !incoming().diff(existing()).affectedKeys().hasAny(['ownerPlayerId', 'ownerId']))
        );
      allow delete: if isAdmin() && isValidId(clubId);
    }

    // Validation Blueprint: ClubJoinRequest (a pending request to join a private club)
    function isValidClubJoinRequest(requestId, data) {
      return data.keys().hasAll([
        'clubId', 'playerId', 'playerName', 'playerTag', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'clubId', 'playerId', 'playerName', 'playerTag', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.clubId) &&
      isValidId(data.playerId) &&
      // One request per player per club: the document id is derived from both
      requestId == 'joinreq_' + data.clubId + '_' + data.playerId &&
      data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 80 &&
      data.playerTag is string && data.playerTag.size() >= 1 && data.playerTag.size() <= 40 &&
      isValidId(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /clubJoinRequests/{requestId}
    // Filed by the requesting player for themselves; removed by them, the club's owner, or an admin.
    match /clubJoinRequests/{requestId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(requestId) &&
        isValidClubJoinRequest(requestId, incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(clubPath(incoming().clubId)) &&
        isPlayerSelf(incoming().playerId);
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(requestId) && (
        isAdmin() ||
        existing().ownerId == request.auth.uid ||
        isPlayerSelf(existing().playerId) ||
        isClubOwner(existing().clubId)
      );
    }

    // Collection: /profileClaims/{uid}
    // An account asking a Site Admin to link it to an existing (unlinked) player profile.
    // Kept apart from /players so the requester's email is only visible to them and admins.
    function isValidProfileClaim(uid, data) {
      return data.keys().hasAll(['playerId', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['playerId', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
      isValidId(data.playerId) &&
      data.email == request.auth.token.email &&
      data.displayName is string && data.displayName.size() <= 80 &&
      data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /profileClaims/{uid} {
      allow get: if isVerifiedUser() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && request.auth.uid == uid &&
        isValidProfileClaim(uid, incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(playerPath(incoming().playerId)) &&
        get(playerPath(incoming().playerId)).data.get('authUid', '') == '';
      allow update: if false;
      allow delete: if isVerifiedUser() && (request.auth.uid == uid || isAdmin());
    }

    // Collection: /sessions/{sessionId} — managed by the club's owner or an admin
    match /sessions/{sessionId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(sessionId) && isValidSession(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        canManageClub(incoming().clubId);
      allow update: if isVerifiedUser() && isValidId(sessionId) && isValidSession(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().clubId == existing().clubId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canManageClub(existing().clubId);
      allow delete: if isVerifiedUser() && isValidId(sessionId) && canManageClub(existing().clubId);
    }

    // Collection: /players/{playerId}
    function appendsClub(clubId) {
      return isValidId(clubId) &&
        !existing().joinedClubIdsCsv.split(',').hasAny([clubId]) &&
        incoming().joinedClubIdsCsv ==
          (existing().joinedClubIdsCsv == '' ? clubId : existing().joinedClubIdsCsv + ',' + clubId);
    }

    function removesClub(playerId, clubId) {
      return isValidId(clubId) &&
        existing().joinedClubIdsCsv.split(',').hasAny([clubId]) &&
        !incoming().joinedClubIdsCsv.split(',').hasAny([clubId]) &&
        incoming().joinedClubIdsCsv.split(',').removeAll(['']).size() ==
          existing().joinedClubIdsCsv.split(',').removeAll(['']).size() - 1 &&
        existing().joinedClubIdsCsv.split(',').hasAll(
          incoming().joinedClubIdsCsv.split(',').removeAll([''])
        ) &&
        (!exists(clubPath(clubId)) || get(clubPath(clubId)).data.get('ownerPlayerId', '') != playerId);
    }

    function hasFreshStats(data) {
      return data.wins == 0 && data.losses == 0 && data.gamesPlayed == 0 &&
        data.pointsScored == 0 && data.pointsConceded == 0 &&
        data.singlesWins == 0 && data.singlesLosses == 0 &&
        data.doublesWins == 0 && data.doublesLosses == 0;
    }

    // P0-4: Match recording updates the stats of the players in that match, in the same batch
    // that creates the match (so one match can only ever be counted once), requiring the player
    // to be a member of the match's club and the match to have createdAt == request.time.
    function matchAuthorizesStats(playerId) {
      let matchId = incoming().get('lastMatchId', '');
      let matchPath = /databases/$(database)/documents/matches/$(matchId);
      return isValidId(matchId) && !exists(matchPath) && existsAfter(matchPath) &&
        getAfter(matchPath).data.createdAt == request.time &&
        canManageClub(getAfter(matchPath).data.clubId) &&
        existing().joinedClubIdsCsv.split(',').hasAny([getAfter(matchPath).data.clubId]) &&
        [
          getAfter(matchPath).data.teamAPlayer1Id, getAfter(matchPath).data.teamAPlayer2Id,
          getAfter(matchPath).data.teamBPlayer1Id, getAfter(matchPath).data.teamBPlayer2Id
        ].hasAny([playerId]) &&
        incoming().gamesPlayed == existing().gamesPlayed + 1 &&
        incoming().wins + incoming().losses == existing().wins + existing().losses + 1;
    }

    // Deleting a match (or deleting a session containing matches) rolls back the stats of
    // the players in it, in the same batch that deletes the match.
    function matchDeletionAuthorizesStats(playerId) {
      let matchId = incoming().get('lastMatchId', '');
      let matchPath = /databases/$(database)/documents/matches/$(matchId);
      return isValidId(matchId) && exists(matchPath) && !existsAfter(matchPath) &&
        canManageClub(get(matchPath).data.clubId) &&
        existing().joinedClubIdsCsv.split(',').hasAny([get(matchPath).data.clubId]) &&
        [
          get(matchPath).data.teamAPlayer1Id, get(matchPath).data.teamAPlayer2Id,
          get(matchPath).data.teamBPlayer1Id, get(matchPath).data.teamBPlayer2Id
        ].hasAny([playerId]) &&
        incoming().gamesPlayed >= 0 &&
        incoming().gamesPlayed < existing().gamesPlayed &&
        incoming().wins <= existing().wins && incoming().losses <= existing().losses &&
        incoming().pointsScored <= existing().pointsScored &&
        incoming().pointsConceded <= existing().pointsConceded;
    }

    function playerUpdateAllowed(playerId) {
      let changed = incoming().diff(existing()).affectedKeys();
      let actingClubId = incoming().get('actingClubId', '');
      return isAdmin() ||
        // The player edits their own display details
        (changed.hasOnly(['name', 'playerTag', 'updatedAt']) && isPlayerSelf(playerId)) ||
        // The player joins a public club themselves
        (changed.hasOnly(['joinedClubIdsCsv', 'actingClubId', 'updatedAt']) &&
          isPlayerSelf(playerId) && appendsClub(actingClubId) && clubIsPublic(actingClubId)) ||
        // A club owner approves a join request / adds the player to their club
        (changed.hasOnly(['joinedClubIdsCsv', 'actingClubId', 'updatedAt']) &&
          appendsClub(actingClubId) && isClubOwner(actingClubId)) ||
        // The player leaves a club they do not own, or the club owner / admin removes them
        (changed.hasOnly(['joinedClubIdsCsv', 'actingClubId', 'updatedAt']) &&
          removesClub(playerId, actingClubId) &&
          (isPlayerSelf(playerId) || canManageClub(actingClubId))) ||
        // A club owner edits a member of their club
        (changed.hasOnly(['name', 'ratingScore', 'actingClubId', 'updatedAt']) &&
          isClubOwner(actingClubId) &&
          existing().joinedClubIdsCsv.split(',').hasAny([actingClubId])) ||
        // Stats from a match recorded or rolled back by that club's manager
        (changed.hasOnly([
            'wins', 'losses', 'gamesPlayed', 'pointsScored', 'pointsConceded',
            'singlesWins', 'singlesLosses', 'doublesWins', 'doublesLosses',
            'ratingScore', 'lastMatchId', 'updatedAt'
          ]) && (matchAuthorizesStats(playerId) || matchDeletionAuthorizesStats(playerId)));
    }

    match /players/{playerId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(playerId) && isValidPlayer(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (
          // P0-3: Self sign-up: one profile per account, fresh stats, ratingScore == 1200, no club or a public one
          (incoming().get('authUid', '') == request.auth.uid &&
            playerId == 'player_' + request.auth.uid &&
            incoming().gamesPlayed == 0 &&
            incoming().wins == 0 &&
            incoming().losses == 0 &&
            incoming().ratingScore == 1200 &&
            incoming().pointsScored == 0 &&
            incoming().pointsConceded == 0 &&
            incoming().singlesWins == 0 &&
            incoming().singlesLosses == 0 &&
            incoming().doublesWins == 0 &&
            incoming().doublesLosses == 0 &&
            (incoming().joinedClubIdsCsv == '' || clubIsPublic(incoming().joinedClubIdsCsv))) ||
          // Unlinked member profile created by an admin, or by a club owner for their club
          (incoming().get('authUid', '') == '' &&
            (isAdmin() || (isClubOwner(incoming().joinedClubIdsCsv) && hasFreshStats(incoming()))))
        );
      allow update: if isVerifiedUser() && isValidId(playerId) && isValidPlayer(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        playerUpdateAllowed(playerId);
      allow delete: if isValidId(playerId) && (isAdmin() || isPlayerSelf(playerId));
    }

    // Collection: /rsvps/{rsvpId}
    // P0-2 & P1-1: Tighten rsvpSelfUpdateAllowed:
    //  - Remove attendanceOutcome and feeShare from the player-changeable set;
    //  - Only allow status/guest changes while session bookingStatus in ['pending','booked'] and !feeSplitFinalized;
    //  - Pin penaltyPercentApplied: 0 when status == 'going' or 'out', and >= club.lateCancelFeePercent when status == 'late_out'.
    function rsvpSelfUpdateAllowed() {
      let changed = incoming().diff(existing()).affectedKeys();
      let s = get(sessionPath(existing().sessionId)).data;
      let c = get(clubPath(existing().clubId)).data;
      return isPlayerSelf(existing().playerId) && (
        // 1. Self display-name sync across all RSVPs
        changed.hasOnly(['playerName', 'updatedAt']) ||
        // 2. Self payment reporting on unpaid or pending RSVPs
        (changed.hasOnly(['paidStatus', 'paidMethod', 'updatedAt']) &&
          existing().paidStatus in ['unpaid', 'pending_approval'] &&
          incoming().paidStatus == 'pending_approval') ||
        // 3. Open-session RSVP status & guestCount/guestNames updates (only while bookingStatus in ['pending','booked'] and !feeSplitFinalized)
        (changed.hasOnly([
            'status', 'penaltyPercentApplied', 'paidStatus', 'paidMethod',
            'playerName', 'guestCount', 'guestNames', 'updatedAt'
          ]) &&
          s.bookingStatus in ['pending', 'booked'] &&
          s.feeSplitFinalized == false &&
          existing().feeShare == 0 &&
          (!changed.hasAny(['paidStatus', 'paidMethod']) ||
            (existing().paidStatus in ['unpaid', 'pending_approval'] && incoming().paidStatus == 'pending_approval')) &&
          (
            (incoming().status == 'going' && incoming().penaltyPercentApplied == 0) ||
            (incoming().status == 'out' && existing().status != 'late_out' && incoming().penaltyPercentApplied == 0) ||
            (incoming().status == 'late_out' && incoming().penaltyPercentApplied >= c.lateCancelFeePercent)
          ))
      );
    }

    match /rsvps/{rsvpId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(rsvpId) && isValidSessionRsvp(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(sessionPath(incoming().sessionId)) &&
        get(sessionPath(incoming().sessionId)).data.clubId == incoming().clubId &&
        exists(playerPath(incoming().playerId)) &&
        (
          canManageClub(incoming().clubId) ||
          (
            // P0-2: Pin deterministic RSVP doc ID, open session, penaltyPercentApplied, and zero wallet ledger fields on self-create
            rsvpId == 'rsvp_' + incoming().sessionId + '_' + incoming().playerId &&
            isPlayerSelf(incoming().playerId) &&
            get(playerPath(incoming().playerId)).data.joinedClubIdsCsv.split(',').hasAny([incoming().clubId]) &&
            get(sessionPath(incoming().sessionId)).data.bookingStatus in ['pending', 'booked'] &&
            !sessionIsFinalized(incoming().sessionId) &&
            incoming().attendanceOutcome == 'present' &&
            incoming().feeShare == 0 &&
            incoming().paidStatus == 'unpaid' &&
            (
              (incoming().status == 'going' && incoming().penaltyPercentApplied == 0) ||
              (incoming().status == 'out' && incoming().penaltyPercentApplied == 0) ||
              (incoming().status == 'late_out' && incoming().penaltyPercentApplied >= get(clubPath(incoming().clubId)).data.lateCancelFeePercent)
            ) &&
            incoming().get('grossFeeShare', 0) == 0 &&
            incoming().get('walletCreditApplied', 0) == 0 &&
            incoming().get('walletPassApplied', false) == false &&
            incoming().get('walletWaiverApplied', false) == false
          )
        );
      allow update: if isVerifiedUser() && isValidId(rsvpId) && isValidSessionRsvp(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().clubId == existing().clubId &&
        incoming().sessionId == existing().sessionId &&
        incoming().playerId == existing().playerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (canManageClub(existing().clubId) || rsvpSelfUpdateAllowed());
      // P0-2: Replace player delete branch with exact guard
      allow delete: if isVerifiedUser() && isValidId(rsvpId) &&
        (
          canManageClub(existing().clubId) ||
          (isPlayerSelf(existing().playerId) && existing().feeShare == 0 && existing().paidStatus == 'unpaid' && sessionIsOpen(existing().sessionId))
        );
    }

    // Collection: /matches/{matchId} — recorded and corrected by the club's owner or an admin
    // P0-4: Require that the four player IDs exist (except singles placeholder NONE)
    match /matches/{matchId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(matchId) && isValidBadmintonMatch(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(sessionPath(incoming().sessionId)) &&
        get(sessionPath(incoming().sessionId)).data.clubId == incoming().clubId &&
        canManageClub(incoming().clubId) &&
        exists(playerPath(incoming().teamAPlayer1Id)) &&
        (incoming().teamAPlayer2Id == 'NONE' || exists(playerPath(incoming().teamAPlayer2Id))) &&
        exists(playerPath(incoming().teamBPlayer1Id)) &&
        (incoming().teamBPlayer2Id == 'NONE' || exists(playerPath(incoming().teamBPlayer2Id)));
      allow update: if isVerifiedUser() && isValidId(matchId) && isValidBadmintonMatch(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().clubId == existing().clubId &&
        incoming().sessionId == existing().sessionId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canManageClub(existing().clubId);
      allow delete: if isVerifiedUser() && isValidId(matchId) && canManageClub(existing().clubId);
    }

    // Validation Blueprint: ClubWallet (one document per club-player pair, managed by club manager)
    function isValidClubWallet(walletId, data) {
      return data.keys().hasAll([
        'clubId', 'playerId', 'creditBalance', 'freeSessionPasses',
        'waiveAllFees', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'clubId', 'playerId', 'creditBalance', 'freeSessionPasses',
        'waiveAllFees', 'ownerId', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.clubId) &&
      isValidId(data.playerId) &&
      walletId == 'wallet_' + data.clubId + '_' + data.playerId &&
      data.creditBalance is number && data.creditBalance >= 0 && data.creditBalance <= 100000 &&
      data.freeSessionPasses is int && data.freeSessionPasses >= 0 && data.freeSessionPasses <= 1000 &&
      data.waiveAllFees is bool &&
      isValidId(data.ownerId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /clubWallets/{walletId}
    // P1-1(b): create/update/delete only by canManageClub(clubId); get/list only by canManageClub or isPlayerSelf
    match /clubWallets/{walletId} {
      allow get: if isVerifiedUser() && isValidId(walletId) &&
        (resource == null || canManageClub(resource.data.clubId) || isPlayerSelf(resource.data.playerId));
      allow list: if isVerifiedUser() &&
        (canManageClub(resource.data.clubId) || isPlayerSelf(resource.data.playerId));
      allow create: if isVerifiedUser() && isValidId(walletId) &&
        isValidClubWallet(walletId, incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        canManageClub(incoming().clubId);
      allow update: if isVerifiedUser() && isValidId(walletId) &&
        isValidClubWallet(walletId, incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().clubId == existing().clubId &&
        incoming().playerId == existing().playerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canManageClub(existing().clubId);
      allow delete: if isVerifiedUser() && isValidId(walletId) &&
        canManageClub(existing().clubId);
    }

    // Validation Blueprint: GearLocker (one document per account, keyed by the owner's uid)
    function isValidGearLocker(data) {
      return data.keys().hasAll(['stateJson', 'version', 'ownerId', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['stateJson', 'version', 'ownerId', 'createdAt', 'updatedAt']) &&
      data.stateJson is string && data.stateJson.size() >= 2 && data.stateJson.size() <= 800000 &&
      data.version == 3 &&
      isValidId(data.ownerId) && data.ownerId == request.auth.uid &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /gearLockers/{ownerId}
    // P0-1: allow get: if isVerifiedUser() && isValidId(ownerId) && ownerId == request.auth.uid;
    match /gearLockers/{ownerId} {
      allow get: if isVerifiedUser() && isValidId(ownerId) && ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(ownerId) && ownerId == request.auth.uid &&
        isValidGearLocker(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(ownerId) && ownerId == request.auth.uid &&
        isValidGearLocker(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['stateJson', 'version', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(ownerId) &&
        (ownerId == request.auth.uid || isAdmin());
    }
  }
}
