{
  "entities": {
    "Club": {
      "title": "Club",
      "description": "A badminton club with configurable tap-out cutoff hours, late withdrawal penalty percentages, and member list.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the badminton club",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Club description and regular schedule",
          "minLength": 1,
          "maxLength": 200
        },
        "paymentInfo": {
          "type": "string",
          "description": "Default club payment instructions",
          "minLength": 1,
          "maxLength": 160
        },
        "freeCancelHours": {
          "type": "number",
          "description": "Hours prior to match before which tapping out is free (0% fee)"
        },
        "lockCancelHours": {
          "type": "number",
          "description": "Hours prior to match within which tapping out is locked or penalized"
        },
        "lateCancelFeePercent": {
          "type": "number",
          "description": "Percentage (0-100) of court fee charged when tapping out inside the penalty window"
        },
        "noShowFeePercent": {
          "type": "number",
          "description": "Percentage (0-100) of fee charged when a confirmed player does not show up"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Whether the club can be joined directly or requires owner approval"
        },
        "ownerPlayerId": {
          "type": "string",
          "description": "Player ID of the assigned Club Owner"
        },
        "excludeOwnerFromBilling": {
          "type": "boolean",
          "description": "When true, the Club Owner's personal spot is excluded from session court/shuttle fee splits"
        },
        "defaultMatchTargetPoints": {
          "type": "number",
          "description": "Default target points per match for this club (1-100)"
        },
        "currency": {
          "type": "string",
          "description": "ISO currency code for club fee display and settlement",
          "minLength": 1,
          "maxLength": 10
        },
        "paymentDetailsJson": {
          "type": "string",
          "description": "Optional JSON-serialized structured payment details",
          "maxLength": 2000
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the club admin",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated"
        }
      },
      "required": [
        "name",
        "description",
        "paymentInfo",
        "freeCancelHours",
        "lockCancelHours",
        "lateCancelFeePercent",
        "noShowFeePercent",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Session": {
      "title": "Session",
      "description": "A scheduled badminton court booking session belonging to a specific club.",
      "type": "object",
      "properties": {
        "clubId": {
          "type": "string",
          "description": "ID of the parent Club",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Name or label of the badminton session",
          "minLength": 1,
          "maxLength": 120
        },
        "venue": {
          "type": "string",
          "description": "Badminton hall or sports center name",
          "minLength": 1,
          "maxLength": 120
        },
        "courtNumbers": {
          "type": "string",
          "description": "Assigned court numbers",
          "minLength": 1,
          "maxLength": 60
        },
        "sessionDate": {
          "type": "string",
          "description": "ISO date string YYYY-MM-DD",
          "minLength": 1,
          "maxLength": 40
        },
        "startTime": {
          "type": "string",
          "description": "Session start time",
          "minLength": 1,
          "maxLength": 20
        },
        "endTime": {
          "type": "string",
          "description": "Session end time",
          "minLength": 1,
          "maxLength": 20
        },
        "bookingStatus": {
          "type": "string",
          "description": "Current court booking status",
          "enum": ["pending", "booked", "in_play", "completed"],
          "minLength": 1,
          "maxLength": 20
        },
        "courtFee": {
          "type": "number",
          "description": "Total court booking cost in dollars"
        },
        "shuttlesUsed": {
          "type": "number",
          "description": "Number of shuttlecocks used during the session"
        },
        "shuttleUnitCost": {
          "type": "number",
          "description": "Cost per shuttlecock in dollars"
        },
        "shuttleFee": {
          "type": "number",
          "description": "Total shuttlecock cost calculated at session end"
        },
        "maxPlayers": {
          "type": "number",
          "description": "Maximum player capacity for the courts"
        },
        "organizerName": {
          "type": "string",
          "description": "Name of the admin organizer who booked the court",
          "minLength": 1,
          "maxLength": 80
        },
        "paymentInfo": {
          "type": "string",
          "description": "Payment handle or instructions for clearing court fees",
          "minLength": 1,
          "maxLength": 160
        },
        "feeSplitFinalized": {
          "type": "boolean",
          "description": "True only after the session ends and admin enters shuttlecocks used"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the workspace owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated"
        }
      },
      "required": [
        "clubId",
        "title",
        "venue",
        "courtNumbers",
        "sessionDate",
        "startTime",
        "endTime",
        "bookingStatus",
        "courtFee",
        "shuttlesUsed",
        "shuttleUnitCost",
        "shuttleFee",
        "maxPlayers",
        "organizerName",
        "paymentInfo",
        "feeSplitFinalized",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Player": {
      "title": "Player",
      "description": "A registered badminton club player with joined club memberships and match statistics.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the player",
          "minLength": 1,
          "maxLength": 80
        },
        "playerTag": {
          "type": "string",
          "description": "Unique cross-device account tag",
          "minLength": 1,
          "maxLength": 40
        },
        "joinedClubIdsCsv": {
          "type": "string",
          "description": "Comma-separated list of club IDs the player has joined (empty string when in no clubs)",
          "minLength": 0,
          "maxLength": 400
        },
        "authUid": {
          "type": "string",
          "description": "Linked Firebase Auth UID for this player profile",
          "minLength": 0,
          "maxLength": 128
        },
        "actingClubId": {
          "type": "string",
          "description": "Club ID authorizing a membership or owner profile update",
          "minLength": 0,
          "maxLength": 128
        },
        "lastMatchId": {
          "type": "string",
          "description": "Match ID authorizing an atomic stat update or rollback",
          "minLength": 0,
          "maxLength": 128
        },
        "wins": {
          "type": "number",
          "description": "Total matches won"
        },
        "losses": {
          "type": "number",
          "description": "Total matches lost"
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Total matches played"
        },
        "pointsScored": {
          "type": "number",
          "description": "Cumulative rally points won"
        },
        "pointsConceded": {
          "type": "number",
          "description": "Cumulative rally points lost"
        },
        "singlesWins": {
          "type": "number",
          "description": "Singles matches won"
        },
        "singlesLosses": {
          "type": "number",
          "description": "Singles matches lost"
        },
        "doublesWins": {
          "type": "number",
          "description": "Doubles matches won"
        },
        "doublesLosses": {
          "type": "number",
          "description": "Doubles matches lost"
        },
        "ratingScore": {
          "type": "number",
          "description": "Calculated composite performance rating"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the workspace owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated"
        }
      },
      "required": [
        "name",
        "playerTag",
        "joinedClubIdsCsv",
        "wins",
        "losses",
        "gamesPlayed",
        "pointsScored",
        "pointsConceded",
        "singlesWins",
        "singlesLosses",
        "doublesWins",
        "doublesLosses",
        "ratingScore",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SessionRsvp": {
      "title": "SessionRsvp",
      "description": "Player attendance confirmation, host no-show marking, and club-owner-cleared fee settlement.",
      "type": "object",
      "properties": {
        "clubId": {
          "type": "string",
          "description": "ID of the Club",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "ID of the parent Session document",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerId": {
          "type": "string",
          "description": "ID of the Player document",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerName": {
          "type": "string",
          "description": "Player display name",
          "minLength": 1,
          "maxLength": 80
        },
        "guestCount": {
          "type": "number",
          "description": "Additional +1 to +4 guests brought by the player and billed to their RSVP share"
        },
        "guestNames": {
          "type": "string",
          "description": "Optional comma-separated or freeform guest names (<= 200 chars)",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "description": "Attendance status",
          "enum": ["going", "out", "late_out"],
          "minLength": 1,
          "maxLength": 20
        },
        "attendanceOutcome": {
          "type": "string",
          "description": "Host-verified attendance outcome",
          "enum": ["present", "no_show", "excused"],
          "minLength": 1,
          "maxLength": 20
        },
        "penaltyPercentApplied": {
          "type": "number",
          "description": "Applicable fee percentage (100 for present, or configured penalty % for late tap-out / no-show)"
        },
        "feeShare": {
          "type": "number",
          "description": "Calculated individual share of court and shuttle fees after session ends"
        },
        "grossFeeShare": {
          "type": "number",
          "description": "Pre-wallet fee share before waiver, free pass, or credit is applied"
        },
        "walletCreditApplied": {
          "type": "number",
          "description": "Dollar credit deducted from the player's club wallet for this RSVP"
        },
        "walletPassApplied": {
          "type": "boolean",
          "description": "True when 1 free session pass was deducted from the player's club wallet for this RSVP"
        },
        "walletWaiverApplied": {
          "type": "boolean",
          "description": "True when the player's club VIP waiver covered this RSVP"
        },
        "paidStatus": {
          "type": "string",
          "description": "Settlement status (only Club Owner can mark paid)",
          "enum": ["unpaid", "pending_approval", "paid"],
          "minLength": 1,
          "maxLength": 20
        },
        "paidMethod": {
          "type": "string",
          "description": "Payment method used or pending marker",
          "minLength": 1,
          "maxLength": 40
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the workspace owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated"
        }
      },
      "required": [
        "clubId",
        "sessionId",
        "playerId",
        "playerName",
        "status",
        "attendanceOutcome",
        "penaltyPercentApplied",
        "feeShare",
        "paidStatus",
        "paidMethod",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "BadmintonMatch": {
      "title": "BadmintonMatch",
      "description": "Completed post-match final score logged within a club session.",
      "type": "object",
      "properties": {
        "clubId": {
          "type": "string",
          "description": "ID of the Club",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "ID of the parent Session document",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "matchFormat": {
          "type": "string",
          "description": "Singles (1v1) or Doubles (2v2)",
          "enum": ["singles", "doubles"],
          "minLength": 1,
          "maxLength": 20
        },
        "teamAPlayer1Id": {
          "type": "string",
          "description": "Team A first player ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamAPlayer1Name": {
          "type": "string",
          "description": "Team A first player name",
          "minLength": 1,
          "maxLength": 80
        },
        "teamAPlayer2Id": {
          "type": "string",
          "description": "Team A second player ID or NONE for singles",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamAPlayer2Name": {
          "type": "string",
          "description": "Team A second player name or None for singles",
          "minLength": 1,
          "maxLength": 80
        },
        "teamBPlayer1Id": {
          "type": "string",
          "description": "Team B first player ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamBPlayer1Name": {
          "type": "string",
          "description": "Team B first player name",
          "minLength": 1,
          "maxLength": 80
        },
        "teamBPlayer2Id": {
          "type": "string",
          "description": "Team B second player ID or NONE for singles",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamBPlayer2Name": {
          "type": "string",
          "description": "Team B second player name or None for singles",
          "minLength": 1,
          "maxLength": 80
        },
        "scoreTeamA": {
          "type": "number",
          "description": "Final total points scored by Team A"
        },
        "scoreTeamB": {
          "type": "number",
          "description": "Final total points scored by Team B"
        },
        "setScoresText": {
          "type": "string",
          "description": "Final score summary",
          "minLength": 1,
          "maxLength": 60
        },
        "winnerSide": {
          "type": "string",
          "description": "Winning team side A or B",
          "enum": ["A", "B"],
          "minLength": 1,
          "maxLength": 5
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the workspace owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated"
        }
      },
      "required": [
        "clubId",
        "sessionId",
        "matchFormat",
        "teamAPlayer1Id",
        "teamAPlayer1Name",
        "teamAPlayer2Id",
        "teamAPlayer2Name",
        "teamBPlayer1Id",
        "teamBPlayer1Name",
        "teamBPlayer2Id",
        "teamBPlayer2Name",
        "scoreTeamA",
        "scoreTeamB",
        "setScoresText",
        "winnerSide",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClubWallet": {
      "title": "ClubWallet",
      "description": "Per-club member benefit wallet storing dollar credit balance, free session passes, and VIP fee waivers.",
      "type": "object",
      "properties": {
        "clubId": {
          "type": "string",
          "description": "ID of the Club",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerId": {
          "type": "string",
          "description": "ID of the Player",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creditBalance": {
          "type": "number",
          "description": "Prepaid dollar credit balance in this club"
        },
        "freeSessionPasses": {
          "type": "number",
          "description": "Remaining free session passes in this club"
        },
        "waiveAllFees": {
          "type": "boolean",
          "description": "When true, all session fees in this club are automatically waived"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the club owner who created/updated the wallet",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clubId",
        "playerId",
        "creditBalance",
        "freeSessionPasses",
        "waiveAllFees",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClubJoinRequest": {
      "title": "ClubJoinRequest",
      "description": "A pending request by a player to join a private club.",
      "type": "object",
      "properties": {
        "clubId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "playerTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clubId",
        "playerId",
        "playerName",
        "playerTag",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProfileClaim": {
      "title": "ProfileClaim",
      "description": "A request from a verified Firebase Auth account to link an existing unlinked player profile.",
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["playerId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Console-provisioned site administrator marker document.",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "GearLocker": {
      "title": "GearLocker",
      "description": "One account's racket, string, grip and shuttle-tube records, stored as a versioned JSON envelope.",
      "type": "object",
      "properties": {
        "stateJson": {
          "type": "string",
          "description": "Serialized equipment envelope (rackets, stringing logs, shuttle tubes, care schedules)",
          "minLength": 2,
          "maxLength": 800000
        },
        "version": {
          "type": "number",
          "description": "Envelope format version; currently 3"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase uid of the owning account; equals the document id"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stateJson", "version", "ownerId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Site administrator account markers"
    },
    "/clubs/{clubId}": {
      "schema": { "$ref": "#/entities/Club" },
      "description": "Badminton clubs and configurable cancellation/fee settings"
    },
    "/clubJoinRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ClubJoinRequest" },
      "description": "Pending requests from players to join private clubs"
    },
    "/profileClaims/{uid}": {
      "schema": { "$ref": "#/entities/ProfileClaim" },
      "description": "Pending requests to link an auth account to an unlinked player profile"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Badminton court sessions and post-session shuttlecock fee splits"
    },
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Club players, joined clubs, and leaderboard statistics"
    },
    "/rsvps/{rsvpId}": {
      "schema": { "$ref": "#/entities/SessionRsvp" },
      "description": "Player session attendance confirmations, no-show statuses, and fee settlements"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/BadmintonMatch" },
      "description": "Recorded post-match final scores"
    },
    "/clubWallets/{walletId}": {
      "schema": { "$ref": "#/entities/ClubWallet" },
      "description": "Per-club member benefit wallets (credits, free passes, VIP waivers)"
    },
    "/gearLockers/{ownerId}": {
      "schema": { "$ref": "#/entities/GearLocker" },
      "description": "Per-account gear locker, keyed by the owner's uid"
    }
  }
}
